---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allInvestors } from '../lib/investors';
import { imagePath } from '../lib/paths';

const people = allInvestors();
---

<BaseLayout title="Family log in — Shen Journal">
  <section class="section page-hero">
    <div class="wrap" style="max-width: 720px">
      <span class="kicker">Family only</span>
      <h1>Log in, then pick who is writing.</h1>
      <p class="muted">
        Anyone can read the journals. Only the family can add one.
        After you log in, Save on the live website stores entries in the family database.
      </p>
      <p class="notice">
        Family login: <code>qianwei.shen@gmail.com</code> / password <code>123456</code>
      </p>

      <div id="login-card" class="card login-box" style="margin-inline: 0">
        <form class="form" data-login>
          <label>
            Email
            <input type="email" name="email" value="qianwei.shen@gmail.com" autocomplete="username" required />
          </label>
          <label>
            Password
            <input type="password" name="password" autocomplete="current-password" required />
          </label>
          <button class="btn btn-ink" type="submit">Log in</button>
          <p class="muted" data-login-error hidden></p>
        </form>
      </div>

      <div id="pick-card" hidden>
        <h2>Who is writing today?</h2>
        <div class="grid-2" style="margin-top: 16px">
          {people.map((person) => (
            <button class="card pick-card" type="button" data-pick={person.slug}>
              <img src={imagePath(person.portrait)} alt="" />
              <div class="card-body">
                <div class="role">{person.role}</div>
                <strong>{person.shortName}</strong>
                <p class="muted">Open my profile, then add a journal.</p>
              </div>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    applyFamilyUI,
    familyLogin,
    getWriter,
    isLoggedIn,
    setLoggedIn,
    setWriter,
  } from '../scripts/family';
  import { investorPath, newHoldingPath, newJournalPath, newReportPath } from '../lib/paths';
  import type { Writer } from '../lib/family-auth';

  const loginCard = document.getElementById('login-card');
  const pickCard = document.getElementById('pick-card');

  function showStep() {
    const inSession = isLoggedIn();
    loginCard?.toggleAttribute('hidden', inSession);
    pickCard?.toggleAttribute('hidden', !inSession);
    applyFamilyUI();
  }

  showStep();

  document.querySelector('[data-login]')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    const data = new FormData(form);
    const button = form.querySelector('button[type="submit"]');
    const error = document.querySelector<HTMLElement>('[data-login-error]');
    if (error) {
      error.hidden = true;
      error.textContent = '';
    }
    if (button) button.setAttribute('disabled', 'true');
    const fail = await familyLogin(String(data.get('email') || ''), String(data.get('password') || ''));
    if (button) button.removeAttribute('disabled');
    if (fail) {
      if (error) {
        error.hidden = false;
        error.textContent = fail;
      }
      return;
    }
    setLoggedIn(true);
    showStep();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((button) => {
    button.addEventListener('click', () => {
      const writer = button.dataset.pick as Writer;
      setWriter(writer);
      applyFamilyUI();
      const next = new URLSearchParams(window.location.search).get('next');
      if (next === 'journal') {
        window.location.href = newJournalPath(writer);
        return;
      }
      if (next === 'portfolio') {
        window.location.href = newHoldingPath(writer);
        return;
      }
      if (next === 'report') {
        window.location.href = newReportPath(writer);
        return;
      }
      window.location.href = investorPath(writer);
    });
  });

  if (isLoggedIn() && getWriter()) {
    const next = new URLSearchParams(window.location.search).get('next');
    if (next === 'journal') window.location.href = newJournalPath(getWriter());
    if (next === 'portfolio') window.location.href = newHoldingPath(getWriter());
    if (next === 'report') window.location.href = newReportPath(getWriter());
  }
</script>
