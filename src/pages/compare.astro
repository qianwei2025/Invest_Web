---
import BaseLayout from '../layouts/BaseLayout.astro';
import { imagePath } from '../lib/paths';
---

<BaseLayout
  title="Compare their thinking — Shen Journal"
  description="Two independent looks at the same companies. Agreement is not required."
>
  <section class="section page-hero">
    <div class="wrap">
      <span class="kicker">Same facts. Different minds.</span>
      <h1>Compare their thinking</h1>
      <p class="lede" style="color:var(--muted); max-width:70ch">
        When both brothers write about the same company, we put the latest
        entries side by side. The point is not to crown a winner. The point is
        to show that careful people can disagree.
      </p>
    </div>
    <div class="wrap" style="margin-top:24px">
      <img src={imagePath('compare-lanterns.jpg')} alt="Two lanterns lighting the same map in different colors" style="width:100%; border-radius:24px; max-height:360px; object-fit:cover;" />
    </div>
  </section>

  <section class="section" style="padding-top:12px">
    <div class="wrap" data-compare>
      <div class="card empty"><h3>Loading comparisons…</h3></div>
    </div>
  </section>
</BaseLayout>

<script>
  import { escapeHtml, fetchJournals, formatShortDate } from '../lib/api';
  import { journalEntryByIdPath } from '../lib/paths';

  const root = document.querySelector('[data-compare]');

  async function load() {
    if (!root) return;
    try {
      const entries = await fetchJournals(undefined, 100);
      const byTicker = new Map<string, typeof entries>();
      for (const entry of entries) {
        const list = byTicker.get(entry.ticker) ?? [];
        list.push(entry);
        byTicker.set(entry.ticker, list);
      }
      const companies = [...byTicker.entries()]
        .map(([ticker, list]) => ({
          ticker,
          company: list[0].company,
          sherman: list.find((item) => item.investor === 'sherman'),
          roy: list.find((item) => item.investor === 'roy'),
        }))
        .filter((row) => row.sherman || row.roy);

      if (!companies.length) {
        root.innerHTML = `<div class="card empty"><h3>Nothing to compare yet</h3><p class="muted">When Sherman and Roy both write about the same company, their notes will sit side by side here.</p></div>`;
        return;
      }

      root.innerHTML = companies
        .map((row) => {
          const col = (person: 'sherman' | 'roy', label: string, entry?: (typeof entries)[number]) => {
            if (!entry) {
              return `<div class="card compare-col"><div class="role">${label}</div><h3>${person === 'sherman' ? 'Sherman Shen' : 'Roy Shen'}</h3><p class="muted">No journal entry yet.</p></div>`;
            }
            return `<div class="card compare-col">
              <div class="role">${label}</div>
              <h3>${person === 'sherman' ? 'Sherman Shen' : 'Roy Shen'}</h3>
              <p><span class="badge">${escapeHtml(entry.action)}</span> · confidence ${Number(entry.confidence)}</p>
              <p><strong>${escapeHtml(entry.title)}</strong></p>
              <p class="muted">${formatShortDate(entry.date)}</p>
              <p><a href="${journalEntryByIdPath(entry.investor, entry.id)}">Read the full entry</a></p>
            </div>`;
          };
          return `<article style="margin-bottom:36px">
            <h2>${escapeHtml(row.company)} <span class="ticker">(${escapeHtml(row.ticker)})</span></h2>
            <div class="compare-grid">
              ${col('sherman', 'Investor 1', row.sherman)}
              ${col('roy', 'Investor 2', row.roy)}
            </div>
          </article>`;
        })
        .join('');
    } catch {
      root.innerHTML = `<div class="card empty"><h3>Could not load comparisons</h3></div>`;
    }
  }

  load();
</script>
