---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import InvestorSubnav from '../../../../components/InvestorSubnav.astro';
import HoldingTable from '../../../../components/HoldingTable.astro';
import { investors, investorStaticPaths, isInvestorSlug } from '../../../../lib/investors';
import { money, percent } from '../../../../lib/format';
import { computePortfolio } from '../../../../lib/portfolio';
import { journalPath, loginPath, newHoldingPath } from '../../../../lib/paths';

export function getStaticPaths() {
  return investorStaticPaths();
}

const slug = Astro.params.investor as string;
if (!isInvestorSlug(slug)) throw new Error('Unknown investor');
const investor = investors[slug];
const portfolio = computePortfolio(slug);
let journal: CollectionEntry<'journal'>[] = [];
try {
  journal = (await getCollection('journal')).filter((entry) => entry.data.investor === slug);
} catch {
  journal = [];
}
const heldTickers = new Set(portfolio.holdings.map((row) => row.ticker));
const watchlist = [...new Map(
  journal
    .filter((entry) => entry.data.action === 'Watch' && !heldTickers.has(entry.data.ticker))
    .map((entry) => [entry.data.ticker, entry] as const),
).values()];
---

<BaseLayout title={`${investor.shortName}’s portfolio — Shen Journal`}>
  <section class="section page-hero">
    <div class="wrap">
      <InvestorSubnav slug={slug} />
      <span class="kicker">Portfolio</span>
      <h1>{investor.shortName}’s holdings</h1>
      <p class="muted">
        A simple learning ledger. Enter buy price, current price, shares, and sell price if sold.
        The site calculates each stock’s return and the total return.
        {portfolio.priceUpdatedAt && ` Last update: ${portfolio.priceUpdatedAt}.`}
      </p>
      <p>
        <a class="btn btn-gold only-family" href={newHoldingPath(slug)}>Add a holding</a>
        <a class="btn" href={`${loginPath()}?next=portfolio`} data-when="logged-out">Family log in</a>
      </p>
      <p class="notice" data-saved-banner hidden>Saved. Refresh if the new holding is not in the list yet.</p>
      <p class="notice">
        It is fine to show holdings here. Do not upload brokerage screenshots or account numbers.
      </p>

      <div class="stat-row" style="margin-top:22px">
        <div class="stat"><span>Total invested</span><strong>{money(portfolio.invested)}</strong></div>
        <div class="stat"><span>Total value</span><strong>{money(portfolio.value)}</strong></div>
        <div class="stat">
          <span>Total return</span>
          <strong class={portfolio.gain >= 0 ? 'pos' : 'neg'}>{money(portfolio.gain)}</strong>
        </div>
        <div class="stat">
          <span>Total return %</span>
          <strong class={portfolio.gainPct >= 0 ? 'pos' : 'neg'}>{percent(portfolio.gainPct)}</strong>
        </div>
      </div>

      {portfolio.holdings.length === 0 ? (
        <div class="card empty" style="margin-top:22px">
          <h3>No holdings yet</h3>
          <p class="muted">
            Log in, pick {investor.shortName}, then click <strong>Add a holding</strong>.
            Fill in buy price, current price, shares, and sell price if it was sold.
          </p>
        </div>
      ) : (
        <>
          <p class="muted">
            {portfolio.openCount} open · {portfolio.soldCount} sold
          </p>
          <HoldingTable investor={slug} holdings={portfolio.holdings} journal={journal} />
        </>
      )}

      {watchlist.length > 0 && (
        <div style="margin-top:36px">
          <h2>Watching</h2>
          <p class="muted">Companies written about as Watch, and not yet held.</p>
          <ul>
            {watchlist.map((entry) => (
              <li>
                <strong>{entry.data.company}</strong>
                <span class="ticker"> {entry.data.ticker}</span>
                — <a href={journalPath(slug) + entry.id.split('/')[1] + '/'}>{entry.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  if (new URLSearchParams(window.location.search).get('saved') === '1') {
    document.querySelector('[data-saved-banner]')?.removeAttribute('hidden');
  }
</script>
