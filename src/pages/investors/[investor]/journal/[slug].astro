---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { investorStaticPaths, isInvestorSlug, investors } from '../../../../lib/investors';
import { journalPath } from '../../../../lib/paths';

/** Old Markdown-based URLs. New entries use /journal/entry/?id= */
export function getStaticPaths() {
  return investorStaticPaths().map((row) => ({
    params: { investor: row.params.investor, slug: 'legacy' },
  }));
}

const slug = Astro.params.investor as string;
if (!isInvestorSlug(slug)) throw new Error('Unknown investor');
const investor = investors[slug];
---

<BaseLayout title={`Journal moved — ${investor.shortName}`}>
  <section class="section page-hero">
    <div class="wrap">
      <h1>This journal link format changed</h1>
      <p class="muted">Open the journals list to find the latest entries.</p>
      <p><a class="btn btn-ink" href={journalPath(slug)}>Back to journals</a></p>
    </div>
  </section>
</BaseLayout>
