---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import InvestorSubnav from '../../../../components/InvestorSubnav.astro';
import ActionBadge from '../../../../components/ActionBadge.astro';
import Confidence from '../../../../components/Confidence.astro';
import { investors, isInvestorSlug } from '../../../../lib/investors';
import { formatDate } from '../../../../lib/format';
import { journalPath, researchNotePath, splitContentId } from '../../../../lib/paths';

export async function getStaticPaths() {
  const entries = await getCollection('journal');
  return entries.map((entry) => {
    const { investor, slug } = splitContentId(entry.id);
    return { params: { investor, slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { investor: investorSlug } = splitContentId(entry.id);
if (!isInvestorSlug(investorSlug)) throw new Error('Unknown investor');
const investor = investors[investorSlug];
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} — ${investor.shortName}`}>
  <section class="section page-hero">
    <div class="wrap">
      <InvestorSubnav slug={investorSlug} />
      <p><a href={journalPath(investorSlug)}>← All journal entries</a></p>
      <span class="kicker">{entry.data.company} · {entry.data.ticker}</span>
      <h1>{entry.data.title}</h1>
      <div class="entry-meta">
        <span>{formatDate(entry.data.date)}</span>
        <ActionBadge action={entry.data.action} />
        <span>Confidence <Confidence level={entry.data.confidence} /></span>
        {entry.data.relatedResearch && (
          <a href={researchNotePath(investorSlug, entry.data.relatedResearch)}>Research note</a>
        )}
      </div>
      <article class="prose card card-body">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>
