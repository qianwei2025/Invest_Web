---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import InvestorSubnav from '../../../../components/InvestorSubnav.astro';
import { investors, investorStaticPaths, isInvestorSlug } from '../../../../lib/investors';
import { newJournalPath } from '../../../../lib/paths';

export function getStaticPaths() {
  return investorStaticPaths();
}

const slug = Astro.params.investor as string;
if (!isInvestorSlug(slug)) throw new Error('Unknown investor');
const investor = investors[slug];
---

<BaseLayout title={`${investor.shortName}’s journals — Shen Journal`}>
  <section class="section page-hero">
    <div class="wrap">
      <InvestorSubnav slug={slug} />
      <span class="kicker">Company journals</span>
      <h1>{investor.shortName}’s journals</h1>
      <p class="muted">
        One entry per company research or decision: thesis, what the business does, risks, and a later reflection on that same idea.
        For week / month / year summaries, use <strong>Reports</strong>.
      </p>
      <p>
        <a class="btn btn-gold only-family" href={newJournalPath(slug)}>Add a journal</a>
      </p>
      <p class="notice" data-saved-banner hidden>Saved. It should appear in the list below.</p>
      <p class="notice" data-deleted-banner hidden>Deleted.</p>
      <div data-journal-list style="margin-top:28px">
        <div class="card empty">
          <h3>Loading journals…</h3>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { deleteJournal, escapeHtml, fetchJournals, formatShortDate } from '../../../../lib/api';
  import { journalEditPath, journalEntryByIdPath, journalPath } from '../../../../lib/paths';
  import { applyFamilyUI, isLoggedIn } from '../../../../scripts/family';

  const investor = location.pathname.split('/').filter(Boolean)[1] || '';
  const root = document.querySelector('[data-journal-list]');

  applyFamilyUI();

  if (new URLSearchParams(location.search).get('saved') === '1') {
    document.querySelector('[data-saved-banner]')?.removeAttribute('hidden');
  }
  if (new URLSearchParams(location.search).get('deleted') === '1') {
    document.querySelector('[data-deleted-banner]')?.removeAttribute('hidden');
  }

  function stars(level: number) {
    return '★'.repeat(level) + '☆'.repeat(Math.max(0, 5 - level));
  }

  function bindDeletes() {
    root?.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((button) => {
      button.addEventListener('click', async () => {
        const id = button.dataset.delete;
        if (!id) return;
        if (!confirm('Delete this journal entry? This cannot be undone.')) return;
        button.disabled = true;
        button.textContent = 'Deleting…';
        try {
          await deleteJournal(id);
          window.location.href = `${journalPath(investor)}?deleted=1`;
        } catch {
          button.disabled = false;
          button.textContent = 'Delete';
          alert('Could not delete. Log in again and try once more.');
        }
      });
    });
  }

  async function load() {
    if (!root) return;
    try {
      const items = await fetchJournals(investor);
      const family = isLoggedIn();
      if (!items.length) {
        root.innerHTML = `<div class="card empty"><h3>Waiting for the first journal</h3><p class="muted">Log in, pick this investor, and click Add a journal when researching a company.</p></div>`;
        return;
      }
      root.innerHTML = `<div class="journal-list">${items
        .map((entry) => {
          const detail = journalEntryByIdPath(entry.investor, entry.id);
          const edit = journalEditPath(entry.investor, entry.id);
          const date = new Date(`${entry.date}T12:00:00`);
          return `<div class="card journal-card journal-row">
            <div class="date-block"><b>${date.getDate()}</b>${date.toLocaleString('en-US', { month: 'short' })} ${date.getFullYear()}</div>
            <div>
              <div class="ticker">${escapeHtml(entry.ticker)} · ${escapeHtml(entry.company)}</div>
              <strong>${escapeHtml(entry.title)}</strong>
              <div class="muted">${formatShortDate(entry.date)} · ${escapeHtml(entry.action)} · ${stars(Number(entry.confidence) || 0)}</div>
            </div>
            <div class="row-actions">
              <a class="btn btn-small btn-ink" href="${detail}">Detail</a>
              ${
                family
                  ? `<a class="btn btn-small" href="${edit}">Edit</a>
                     <button class="btn btn-small" type="button" data-delete="${entry.id}">Delete</button>`
                  : ''
              }
            </div>
          </div>`;
        })
        .join('')}</div>`;
      bindDeletes();
      applyFamilyUI();
    } catch {
      root.innerHTML = `<div class="card empty"><h3>Could not load journals</h3><p class="muted">Check your connection and refresh.</p></div>`;
    }
  }

  load();
</script>
