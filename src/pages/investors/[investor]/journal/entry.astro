---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import InvestorSubnav from '../../../../components/InvestorSubnav.astro';
import { investors, investorStaticPaths, isInvestorSlug } from '../../../../lib/investors';
import { journalPath, loginPath } from '../../../../lib/paths';

export function getStaticPaths() {
  return investorStaticPaths();
}

const slug = Astro.params.investor as string;
if (!isInvestorSlug(slug)) throw new Error('Unknown investor');
const investor = investors[slug];
---

<BaseLayout title={`Journal entry — ${investor.shortName}`}>
  <section class="section page-hero">
    <div class="wrap">
      <InvestorSubnav slug={slug} />
      <p><a href={journalPath(slug)}>← All journal entries</a></p>
      <div data-journal-entry>
        <div class="card empty"><h3>Loading entry…</h3></div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { deleteJournal, escapeHtml, fetchJournal, formatShortDate } from '../../../../lib/api';
  import { journalEditPath, journalPath, loginPath } from '../../../../lib/paths';
  import { applyFamilyUI, isLoggedIn } from '../../../../scripts/family';

  const root = document.querySelector('[data-journal-entry]');
  const id = new URLSearchParams(location.search).get('id');
  const investor = location.pathname.split('/').filter(Boolean)[1] || '';

  applyFamilyUI();

  function block(title: string, body: string) {
    if (!body.trim()) return '';
    return `<h2>${escapeHtml(title)}</h2><p>${escapeHtml(body).replace(/\n/g, '<br>')}</p>`;
  }

  async function load() {
    if (!root) return;
    if (!id) {
      root.innerHTML = `<div class="card empty"><h3>Missing entry id</h3></div>`;
      return;
    }
    try {
      const entry = await fetchJournal(id);
      const family = isLoggedIn();
      root.innerHTML = `
        <span class="kicker">${escapeHtml(entry.company)} · ${escapeHtml(entry.ticker)}</span>
        <h1>${escapeHtml(entry.title)}</h1>
        <div class="entry-meta">
          <span>${formatShortDate(entry.date)}</span>
          <span class="badge">${escapeHtml(entry.action)}</span>
          <span>Confidence ${'★'.repeat(Number(entry.confidence) || 0)}</span>
        </div>
        ${
          family
            ? `<p class="only-family" style="display:flex;gap:8px;flex-wrap:wrap;margin:16px 0">
                <a class="btn btn-ink btn-small" href="${journalEditPath(entry.investor, entry.id)}">Edit</a>
                <button class="btn btn-small" type="button" data-delete>Delete</button>
              </p>
              <p class="muted" data-status></p>`
            : `<p class="muted"><a href="${loginPath()}">Family log in</a> to edit or delete.</p>`
        }
        <article class="prose card card-body">
          ${block('My Thesis', entry.thesis)}
          ${block('What Does This Company Actually Do?', entry.does)}
          ${block('Why Might This Be a Good Investment?', entry.good)}
          ${block('What Could Go Wrong?', entry.wrong)}
          ${block('What Did I Learn While Researching It?', entry.learned)}
        </article>`;

      root.querySelector('[data-delete]')?.addEventListener('click', async () => {
        if (!confirm('Delete this journal entry? This cannot be undone.')) return;
        const status = root.querySelector<HTMLElement>('[data-status]');
        if (status) status.textContent = 'Deleting…';
        try {
          await deleteJournal(entry.id);
          window.location.href = `${journalPath(investor)}?deleted=1`;
        } catch {
          if (status) status.textContent = 'Could not delete. Log in again and try once more.';
        }
      });
    } catch {
      root.innerHTML = `<div class="card empty"><h3>Could not load this entry</h3></div>`;
    }
  }

  load();
</script>
