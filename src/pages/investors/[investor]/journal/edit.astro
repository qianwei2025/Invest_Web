---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import InvestorSubnav from '../../../../components/InvestorSubnav.astro';
import { investors, investorStaticPaths, isInvestorSlug } from '../../../../lib/investors';
import { journalEntryByIdPath, loginPath } from '../../../../lib/paths';

export function getStaticPaths() {
  return investorStaticPaths();
}

const slug = Astro.params.investor as string;
if (!isInvestorSlug(slug)) throw new Error('Unknown investor');
const investor = investors[slug];
---

<BaseLayout title={`Edit journal — ${investor.shortName}`}>
  <section class="section page-hero">
    <div class="wrap" style="max-width: 760px">
      <InvestorSubnav slug={slug} />
      <span class="kicker">{investor.name}</span>
      <h1>Edit journal entry</h1>

      <div class="card card-body" data-gate hidden>
        <p>Log in first to edit a journal.</p>
        <p><a class="btn btn-ink" href={loginPath()}>Family log in</a></p>
      </div>

      <div data-loading class="card empty"><h3>Loading…</h3></div>

      <form class="form card card-body" data-journal-form hidden>
        <input type="hidden" name="investor" value={slug} />
        <label>
          Date
          <input type="date" name="date" required />
        </label>
        <label>
          Company
          <input name="company" required />
        </label>
        <label>
          Ticker
          <input name="ticker" />
        </label>
        <label>
          Title
          <input name="title" required />
        </label>
        <label>
          Action
          <select name="action">
            <option>Watch</option>
            <option>Buy</option>
            <option>Hold</option>
            <option>Sell</option>
          </select>
        </label>
        <label>
          Confidence
          <select name="confidence">
            <option value="1">1 — just a hunch</option>
            <option value="2">2 — still shaky</option>
            <option value="3">3 — some reasons, some gaps</option>
            <option value="4">4 — I can explain it</option>
            <option value="5">5 — I would explain it to a friend</option>
          </select>
        </label>
        <label>
          My thesis
          <textarea name="thesis" required></textarea>
        </label>
        <label>
          What does this company actually do?
          <textarea name="does" required></textarea>
        </label>
        <label>
          Why might this be a good investment?
          <textarea name="good"></textarea>
        </label>
        <label>
          What could go wrong?
          <textarea name="wrong"></textarea>
        </label>
        <label>
          What did I learn while researching it?
          <textarea name="learned"></textarea>
        </label>
        <button class="btn btn-gold" type="submit">Save changes</button>
        <p class="muted" data-save-status></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import { fetchJournal, updateJournal } from '../../../../lib/api';
  import type { JournalInput } from '../../../../lib/journal-file';
  import { journalEntryByIdPath, loginPath } from '../../../../lib/paths';
  import { applyFamilyUI, isLoggedIn } from '../../../../scripts/family';

  const form = document.querySelector<HTMLFormElement>('[data-journal-form]');
  const gate = document.querySelector<HTMLElement>('[data-gate]');
  const loading = document.querySelector<HTMLElement>('[data-loading]');
  const status = document.querySelector<HTMLElement>('[data-save-status]');
  const id = new URLSearchParams(location.search).get('id');

  applyFamilyUI();
  const allowed = isLoggedIn();
  if (gate) gate.hidden = allowed;
  if (!allowed) {
    if (loading) loading.hidden = true;
  }

  async function load() {
    if (!allowed || !form || !id) {
      if (loading) loading.hidden = true;
      if (!id && form) form.hidden = true;
      return;
    }
    try {
      const entry = await fetchJournal(id);
      const set = (name: string, value: string) => {
        const el = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
        if (el) el.value = value;
      };
      set('investor', entry.investor);
      set('date', entry.date);
      set('company', entry.company);
      set('ticker', entry.ticker);
      set('title', entry.title);
      set('action', entry.action);
      set('confidence', String(entry.confidence));
      set('thesis', entry.thesis);
      set('does', entry.does);
      set('good', entry.good);
      set('wrong', entry.wrong);
      set('learned', entry.learned);
      if (loading) loading.hidden = true;
      form.hidden = false;
    } catch {
      if (loading) loading.innerHTML = `<h3>Could not load this journal</h3><p><a href="${loginPath()}">Log in</a> and try again.</p>`;
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!isLoggedIn() || !id) return;
    const data = new FormData(form);
    const input: JournalInput = {
      investor: String(data.get('investor')) as JournalInput['investor'],
      date: String(data.get('date')),
      title: String(data.get('title')),
      company: String(data.get('company')),
      ticker: String(data.get('ticker')),
      action: String(data.get('action')) as JournalInput['action'],
      confidence: Number(data.get('confidence')),
      thesis: String(data.get('thesis')),
      does: String(data.get('does')),
      good: String(data.get('good')),
      wrong: String(data.get('wrong')),
      learned: String(data.get('learned')),
    };
    if (status) status.textContent = 'Saving…';
    try {
      await updateJournal(id, input);
      window.location.href = journalEntryByIdPath(input.investor, id);
    } catch {
      if (status) status.textContent = 'Could not save changes. Log in again and try once more.';
    }
  });

  load();
</script>
