---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import InvestorSubnav from '../../../../components/InvestorSubnav.astro';
import { investors, investorStaticPaths, isInvestorSlug } from '../../../../lib/investors';
import { formatDate } from '../../../../lib/format';
import { newReportPath, reportPath, splitContentId } from '../../../../lib/paths';

export function getStaticPaths() {
  return investorStaticPaths();
}

const slug = Astro.params.investor as string;
if (!isInvestorSlug(slug)) throw new Error('Unknown investor');
const investor = investors[slug];

let reports = [];
try {
  reports = (await getCollection('reports'))
    .filter((entry) => entry.data.investor === slug)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
} catch {
  reports = [];
}
---

<BaseLayout title={`${investor.shortName}’s reports — Shen Journal`}>
  <section class="section page-hero">
    <div class="wrap">
      <InvestorSubnav slug={slug} />
      <span class="kicker">Learning reports</span>
      <h1>{investor.shortName}’s reports</h1>
      <p class="muted">
        Write a report whenever it helps — after a week, a month, a year, or any stretch of learning.
        No fixed schedule required.
      </p>
      <p>
        <a class="btn btn-gold only-family" href={newReportPath(slug)}>Add a report</a>
      </p>
      <p class="notice" data-saved-banner hidden>Saved. Refresh if the new report is not in the list yet.</p>

      {reports.length === 0 ? (
        <div class="card empty" style="margin-top:28px">
          <h3>No reports yet</h3>
          <p class="muted">
            Journals are for one company. Reports are for summarizing learning over time.
            Add one when there is something worth remembering.
          </p>
        </div>
      ) : (
        <div class="journal-list" style="margin-top:28px">
          {reports.map((entry) => {
            const ids = splitContentId(entry.id);
            return (
              <a class="card journal-card" href={reportPath(slug, ids.slug)}>
                <div class="date-block">
                  <b>{entry.data.period}</b>
                  {formatDate(entry.data.date)}
                </div>
                <div>
                  <strong>{entry.data.title}</strong>
                  <div class="muted">Period: {entry.data.period}</div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  if (new URLSearchParams(window.location.search).get('saved') === '1') {
    document.querySelector('[data-saved-banner]')?.removeAttribute('hidden');
  }
</script>
