---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import InvestorSubnav from '../../../../components/InvestorSubnav.astro';
import { investors, investorStaticPaths, isInvestorSlug } from '../../../../lib/investors';
import { newReportPath } from '../../../../lib/paths';

export function getStaticPaths() {
  return investorStaticPaths();
}

const slug = Astro.params.investor as string;
if (!isInvestorSlug(slug)) throw new Error('Unknown investor');
const investor = investors[slug];
---

<BaseLayout title={`${investor.shortName}’s reports — Shen Journal`}>
  <section class="section page-hero">
    <div class="wrap">
      <InvestorSubnav slug={slug} />
      <span class="kicker">Learning reports</span>
      <h1>{investor.shortName}’s reports</h1>
      <p class="muted">
        Write a report whenever it helps — after a week, a month, a year, or any stretch of learning.
        No fixed schedule required.
      </p>
      <p>
        <a class="btn btn-gold only-family" href={newReportPath(slug)}>Add a report</a>
      </p>
      <p class="notice" data-saved-banner hidden>Saved. It should appear in the list below.</p>
      <p class="notice" data-deleted-banner hidden>Deleted.</p>
      <div data-report-list style="margin-top:28px">
        <div class="card empty"><h3>Loading reports…</h3></div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { deleteReport, escapeHtml, fetchReports, formatShortDate } from '../../../../lib/api';
  import { reportEditPath, reportEntryByIdPath, reportsPath } from '../../../../lib/paths';
  import { applyFamilyUI, isLoggedIn } from '../../../../scripts/family';

  const investor = location.pathname.split('/').filter(Boolean)[1] || '';
  const root = document.querySelector('[data-report-list]');

  applyFamilyUI();

  if (new URLSearchParams(location.search).get('saved') === '1') {
    document.querySelector('[data-saved-banner]')?.removeAttribute('hidden');
  }
  if (new URLSearchParams(location.search).get('deleted') === '1') {
    document.querySelector('[data-deleted-banner]')?.removeAttribute('hidden');
  }

  function bindDeletes() {
    root?.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((button) => {
      button.addEventListener('click', async () => {
        const id = button.dataset.delete;
        if (!id) return;
        if (!confirm('Delete this report? This cannot be undone.')) return;
        button.disabled = true;
        button.textContent = 'Deleting…';
        try {
          await deleteReport(id);
          window.location.href = `${reportsPath(investor)}?deleted=1`;
        } catch {
          button.disabled = false;
          button.textContent = 'Delete';
          alert('Could not delete. Log in again and try once more.');
        }
      });
    });
  }

  async function load() {
    if (!root) return;
    try {
      const items = await fetchReports(investor);
      const family = isLoggedIn();
      if (!items.length) {
        root.innerHTML = `<div class="card empty"><h3>No reports yet</h3><p class="muted">Journals are for one company. Reports are for summarizing learning over time.</p></div>`;
        return;
      }
      root.innerHTML = `<div class="journal-list">${items
        .map((entry) => {
          const detail = reportEntryByIdPath(entry.investor, entry.id);
          const edit = reportEditPath(entry.investor, entry.id);
          return `<div class="card journal-card journal-row">
            <div class="date-block"><b>${escapeHtml(entry.period)}</b>${formatShortDate(entry.date)}</div>
            <div>
              <strong>${escapeHtml(entry.title)}</strong>
              <div class="muted">Period: ${escapeHtml(entry.period)}</div>
            </div>
            <div class="row-actions">
              <a class="btn btn-small btn-ink" href="${detail}">Detail</a>
              ${
                family
                  ? `<a class="btn btn-small" href="${edit}">Edit</a>
                     <button class="btn btn-small" type="button" data-delete="${entry.id}">Delete</button>`
                  : ''
              }
            </div>
          </div>`;
        })
        .join('')}</div>`;
      bindDeletes();
      applyFamilyUI();
    } catch {
      root.innerHTML = `<div class="card empty"><h3>Could not load reports</h3></div>`;
    }
  }

  load();
</script>
